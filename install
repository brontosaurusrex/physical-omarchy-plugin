#!/usr/bin/env bash
set -euo pipefail
project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
target_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/b.physical"

prebuilt=false
case "${1:-}" in
  --prebuilt) prebuilt=true ;;
  --help) echo 'Usage: ./install [--prebuilt]'; echo 'Build from source, or install an extracted bundle without compilers.'; exit 0 ;;
  '') ;;
  *) echo 'Usage: ./install [--prebuilt]' >&2; exit 1 ;;
esac

# Build dependencies are not part of a normal Omarchy install. Offer to install
# only the missing Arch packages before compiling the Qt module and Go engine.
build_packages=(qt6-base qt6-declarative qt6-multimedia qt6-wayland wayland)
if ! $prebuilt; then build_packages+=(gcc go pkgconf wayland-protocols); fi
missing_packages=()
if ! command -v pacman >/dev/null 2>&1; then
  echo "This installer currently expects Omarchy/Arch Linux (pacman)." >&2
  exit 1
fi
for package in "${build_packages[@]}"; do
  if ! pacman -Qq "$package" >/dev/null 2>&1; then
    missing_packages+=("$package")
  fi
done
if ((${#missing_packages[@]})); then
  echo "Physical needs these packages: ${missing_packages[*]}"
  if [[ ! -t 0 || ! -t 1 ]]; then
    echo "Run this installer in a terminal to approve package installation, or install them with: omarchy pkg add ${missing_packages[*]}" >&2
    exit 1
  fi
  read -r -p "Install missing packages now? [Y/n] " answer
  case "$answer" in
    n|N|no|NO)
      echo "Install them with: omarchy pkg add ${missing_packages[*]}" >&2
      exit 1
      ;;
  esac
  omarchy pkg add "${missing_packages[@]}"
fi

if $prebuilt; then
  [[ -x $project_dir/bin/physical-engine && -f $project_dir/native/libphysicalrenderer.so ]] || { echo 'Missing runtime binaries; use ./install to build from source.' >&2; exit 1; }
  if [[ -f $project_dir/SHA256SUMS ]]; then
    (cd "$project_dir" && sha256sum --quiet -c SHA256SUMS)
  fi
  if [[ -f $project_dir/BUILD-INFO.json ]]; then
    [[ $(jq -r .architecture "$project_dir/BUILD-INFO.json") == $(uname -m) ]] || { echo 'This bundle is for a different CPU architecture; build from source.' >&2; exit 1; }
    built_qt=$(jq -r .qt "$project_dir/BUILD-INFO.json")
    runtime_qt=$(/usr/lib/qt6/bin/qtpaths --qt-version)
    if [[ ${built_qt%.*} != ${runtime_qt%.*} ]]; then
      echo "Bundle built with Qt $built_qt; this machine has Qt $runtime_qt. Use ./install to build against your Qt version." >&2
      exit 1
    fi
  fi
  dependencies=$(ldd "$project_dir/native/libphysicalrenderer.so" 2>&1 || true)
  if [[ $dependencies == *"not found"* ]]; then
    echo 'Missing runtime libraries; build from source or install the compatible Qt runtime.' >&2
    exit 1
  fi
else
  for tool in g++ pkg-config go wayland-scanner; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      echo "Required build tool '$tool' is still unavailable; install its Arch package and rerun ./install." >&2
      exit 1
    fi
  done
  if [[ ! -x /usr/lib/qt6/moc ]] || ! pkg-config --exists Qt6Qml Qt6Quick Qt6Gui Qt6Multimedia; then
    echo "Qt build tools are still unavailable; install qt6-base, qt6-declarative and qt6-multimedia, then rerun ./install." >&2
    exit 1
  fi
  "$project_dir/build"
fi
omarchy plugin validate "$project_dir"
mkdir -p "$target_dir"
if [[ -f $target_dir/manifest.json ]] && [[ $(jq -r .id "$target_dir/manifest.json") != b.physical ]]; then
  echo "Refusing to overwrite a different plugin at $target_dir" >&2
  exit 1
fi
if [[ $project_dir != "$(cd -- "$target_dir" && pwd)" ]]; then
# Replace the executable atomically so reinstalling works while it is running.
mkdir -p "$target_dir/bin"
engine_temp=$(mktemp "$target_dir/bin/.physical-engine.XXXXXX")
trap 'rm -f -- "$engine_temp"' EXIT
cp -a "$project_dir/bin/physical-engine" "$engine_temp"
mv -f -- "$engine_temp" "$target_dir/bin/physical-engine"
# Install a copy: Omarchy rejects symlinks in plugin packages.
for entry in manifest.json Plugin.qml Physical.qml GameCore.qml BarWidget.qml BallWidget.qml GameButton.qml HudButton.qml GameMenu.qml GameCanvas.qml Tuner.qml AudioPool.qml CanvasRenderer.js physical-window theme sounds fonts LICENSE licenses; do
  cp -a "$project_dir/$entry" "$target_dir/"
done
mkdir -p "$target_dir/native"
renderer_temp=$(mktemp "$target_dir/native/.physicalrenderer.XXXXXX")
cp -a "$project_dir/native/libphysicalrenderer.so" "$renderer_temp"
mv -f -- "$renderer_temp" "$target_dir/native/libphysicalrenderer.so"
cp -a "$project_dir/native/setup-module.py" "$target_dir/native/setup-module.py"
printf 'plugin physicalrenderer %s/native\n' "$target_dir" > "$target_dir/native/qmldir"
fi
omarchy plugin validate "$target_dir"
# Restart first to load the new native module. A shell can answer IPC before
# its asynchronous manifest scan finishes, so wait for registration to enable.
omarchy restart shell
echo 'Waiting for Omarchy to discover Physical...'
deadline=$((SECONDS + 15))
discovered=false
while ((SECONDS < deadline)); do
  if plugins=$(OMARCHY_SHELL_IPC_TIMEOUT=0.5s omarchy-shell shell listPlugins 2>/dev/null) &&
     jq -e 'type == "array" and any(.[]; .id == "b.physical")' >/dev/null 2>&1 <<< "$plugins"; then
    discovered=true
    break
  fi
  sleep 0.1
done
if ! $discovered; then
  echo "Physical files are installed at $target_dir, but Omarchy did not discover the plugin within 15 seconds. Check the running shell and rerun ./install --prebuilt." >&2
  exit 1
fi
omarchy plugin enable b.physical
echo "Installed Physical. Open it from the white ball icon or: omarchy-shell shell toggle b.physical"
