#!/usr/bin/env bash
set -euo pipefail
project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
target_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/b.physical"

# Build dependencies are not part of a normal Omarchy install. Offer to install
# only the missing Arch packages before compiling the Qt module and Go engine.
build_packages=(gcc go pkgconf qt6-base qt6-declarative qt6-multimedia qt6-wayland wayland wayland-protocols)
missing_packages=()
if ! command -v pacman >/dev/null 2>&1; then
  echo "This installer currently expects Omarchy/Arch Linux (pacman)." >&2
  exit 1
fi
for package in "${build_packages[@]}"; do
  if ! pacman -Qq "$package" >/dev/null 2>&1; then
    missing_packages+=("$package")
  fi
done
if ((${#missing_packages[@]})); then
  echo "Physical needs these build/runtime packages: ${missing_packages[*]}"
  if [[ ! -t 0 || ! -t 1 ]]; then
    echo "Run this installer in a terminal to approve package installation, or install them with: omarchy pkg add ${missing_packages[*]}" >&2
    exit 1
  fi
  read -r -p "Install missing packages now? [Y/n] " answer
  case "$answer" in
    n|N|no|NO)
      echo "Install them with: omarchy pkg add ${missing_packages[*]}" >&2
      exit 1
      ;;
  esac
  omarchy pkg add "${missing_packages[@]}"
fi

for tool in g++ pkg-config go wayland-scanner; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "Required build tool '$tool' is still unavailable; install its Arch package and rerun ./install." >&2
    exit 1
  fi
done
if [[ ! -x /usr/lib/qt6/moc ]] || ! pkg-config --exists Qt6Qml Qt6Quick Qt6Gui Qt6Multimedia; then
  echo "Qt build tools are still unavailable; install qt6-base, qt6-declarative and qt6-multimedia, then rerun ./install." >&2
  exit 1
fi

"$project_dir/build"
omarchy plugin validate "$project_dir"
mkdir -p "$target_dir"
if [[ -f $target_dir/manifest.json ]] && [[ $(jq -r .id "$target_dir/manifest.json") != b.physical ]]; then
  echo "Refusing to overwrite a different plugin at $target_dir" >&2
  exit 1
fi
# Replace the executable atomically so reinstalling works while it is running.
mkdir -p "$target_dir/bin"
engine_temp=$(mktemp "$target_dir/bin/.physical-engine.XXXXXX")
trap 'rm -f -- "$engine_temp"' EXIT
cp -a "$project_dir/bin/physical-engine" "$engine_temp"
mv -f -- "$engine_temp" "$target_dir/bin/physical-engine"
# Install a copy: Omarchy rejects symlinks in plugin packages.
for entry in manifest.json Physical.qml BarWidget.qml BallWidget.qml GameButton.qml HudButton.qml GameMenu.qml GameCanvas.qml Tuner.qml AudioPool.qml CanvasRenderer.js physical-window sounds fonts; do
  cp -a "$project_dir/$entry" "$target_dir/"
done
mkdir -p "$target_dir/native"
renderer_temp=$(mktemp "$target_dir/native/.physicalrenderer.XXXXXX")
cp -a "$project_dir/native/libphysicalrenderer.so" "$renderer_temp"
mv -f -- "$renderer_temp" "$target_dir/native/libphysicalrenderer.so"
printf 'plugin physicalrenderer %s/native\n' "$target_dir" > "$target_dir/native/qmldir"
omarchy plugin validate "$target_dir"
omarchy-shell shell rescanPlugins
omarchy plugin enable b.physical
echo "Installed Physical. Open it from the white ball icon or: omarchy-shell shell toggle b.physical"
