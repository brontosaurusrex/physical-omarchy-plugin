#!/usr/bin/env bash
# A runtime rule gives the plugin the same floating-window behavior as Radio Atlas.
set -euo pipefail
width=${1:-1280}
height=${2:-642}
[[ $width =~ ^[0-9]+$ && $height =~ ^[0-9]+$ ]] || exit 2
[[ $(hyprctl -j status | jq -r '.configProvider // ""') == lua ]] || exit 0
read -r -d '' setup <<LUA || true
if _G.physical_plugin_window_rule then
  _G.physical_plugin_window_rule:set_enabled(false)
end
local top = 0
local monitor = hl.get_active_monitor()
if monitor then
  -- Shell layers may cover the whole screen for popups. Only the reserved
  -- work area measures the space actually occupied by the bar.
  top = (monitor.reserved or {}).top or 0
end
_G.physical_plugin_window_rule = hl.window_rule({
  name = "physical-plugin",
  match = { initial_class = "^org[.]quickshell$", initial_title = "^Physical$" },
  float = true,
  move = { "(monitor_w - $width) / 2", top },
  size = { $width, $height },
  border_size = 0,
})
LUA
response=$(hyprctl eval "$setup")
[[ $response == ok ]] || { echo "$response" >&2; exit 1; }
